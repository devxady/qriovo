VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
# Optional for local-only smoke tests while Firebase Emulator Suite is running:
# VITE_USE_FIREBASE_EMULATORS=true
VITE_SUPER_ADMIN_API_BASE_URL=
# Leave blank to use site.config.json; set only when the production domain changes.
VITE_PUBLIC_SITE_URL=
